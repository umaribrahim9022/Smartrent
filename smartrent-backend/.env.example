PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/smartrent?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key
CLIENT_URL=http://localhost:5173

# Cloudinary (Property Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Primary Email Service - No Custom Domain Required)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME=SmartRent.AI

# Resend (Alternative)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=SmartRent <onboarding@resend.dev>

# Nodemailer / Fallback Email Service
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# AI / LLM Keys
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

